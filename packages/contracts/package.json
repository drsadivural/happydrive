{
  "name": "@happydrive/contracts",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.yaml": "./openapi.yaml"
  },
  "scripts": {
    "gen": "openapi-typescript openapi.yaml -o src/schema.d.ts",
    "lint": "redocly lint openapi.yaml --format=stylish",
    "check-generated": "openapi-typescript openapi.yaml -o /tmp/hd-schema-check.d.ts && diff -q /tmp/hd-schema-check.d.ts src/schema.d.ts"
  },
  "devDependencies": {
    "@redocly/cli": "^2.54.2",
    "openapi-typescript": "^7.13.0"
  }
}

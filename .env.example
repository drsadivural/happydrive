# ---- API (services/api) -------------------------------------------------------
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql://happydrive:happydrive@localhost:5433/happydrive
REDIS_URL=redis://localhost:6380
LOG_LEVEL=info
# Behind a load balancer set hop count (e.g. 1) or its CIDR. Never "true".
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Secrets (required in staging/production; dev falls back to insecure defaults)
JWT_SECRET=
# 32 random bytes, base64:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=
DATA_HMAC_KEY=

# Providers. Production refuses console SMS / local storage / sandbox payouts.
SMS_PROVIDER=console            # console (dev only) | none
STORAGE_PROVIDER=local          # local (dev only) | s3
OBJECT_STORE_BUCKET=happydrive-staging
OBJECT_STORE_REGION=ap-northeast-1
OBJECT_STORE_ENDPOINT=
LOCAL_STORAGE_DIR=.data/objects
LOCAL_STORAGE_SIGNING_KEY=
PAYOUT_PROVIDER=sandbox         # sandbox (dev/staging) | none
PAYOUT_WEBHOOK_SECRET=

# APNs token auth (optional; without it only in-app notifications are delivered)
APNS_ENVIRONMENT=sandbox
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=jp.happydrive.app
APNS_PRIVATE_KEY=

# Apple App Review account (fixed OTP for one number only; see docs/spec/APPLE_RELEASE.md)
REVIEW_ACCOUNT_PHONE=
REVIEW_ACCOUNT_CODE=

# Business parameters (see docs/DECISIONS_REQUIRED.md)
TERMS_VERSION=2026-09-26
PRIVACY_VERSION=2026-09-26
WORKER_FEE_PERCENT=0
PLATFORM_FEE_PERCENT=0
MIN_HOURLY_WAGE_YEN=1300
LOCATION_RETENTION_DAYS=30
RECIPIENT_CONTACT_RETENTION_DAYS=7

# ---- Web apps (apps/partner-web, apps/admin-web) ------------------------------
HD_API_BASE_URL=http://localhost:8080/v1
RATE_LIMIT_PER_MINUTE=300
